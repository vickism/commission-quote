{
  "name": "commission-quote",
  "description": "Commission quote application built with Next.js, TypeScript and Mantine.",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "run-p --race --print-label dev:app mock:vendor",
    "dev:app": "next dev",
    "build": "next build",
    "audit": "better-npm-audit audit",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs .",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx,css}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx,css}\"",
    "test": "npx next typegen && npm run format:test && npm run lint && npm run typecheck && npm run jest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "mock:vendor": "mockoon-cli start --data ./mocks/commission-vendor.json --port 4001"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/form": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@next/bundle-analyzer": "^16.0.0",
    "@tabler/icons-react": "^3.35.0",
    "better-npm-audit": "^4.2.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@faker-js/faker": "10.6.0",
    "glob@>=9 <14.0.2": "^14.0.6",
    "joi": "18.3.2",
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "^7.4.6"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@mockoon/cli": "^9.10.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "babel-loader": "^10.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "npm-run-all2": "^9.0.4",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "core-js-pure": false
  }
}
